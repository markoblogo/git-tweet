{
  "name": "git-tweet",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "serve:e2e": "next build && next start -H 127.0.0.1 -p 3000",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "replay:release": "node scripts/replay-webhook.mjs --event=release --fixture=fixtures/webhooks/release-published.json",
    "replay:tag": "node scripts/replay-webhook.mjs --event=create --fixture=fixtures/webhooks/create-tag.json",
    "vercel-build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "pretest": "prisma generate",
    "typecheck": "tsc --noEmit",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "preview": "tsx scripts/preview-post.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.19.4",
    "@prisma/client": "5.22.0",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
